{%- set t = i18n[lang] -%}
{%- set regionName = "" -%}
{%- for r in ports.regions -%}{%- if r.id == port.region -%}{%- set regionName = r[lang] -%}{%- endif -%}{%- endfor -%}
<article class="article wrap-narrow">
  <header class="article-head">
    <p class="article-section"><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.ports.title }}</a> · {{ regionName }}</p>
    <h1>{{ port.name[lang] }}</h1>
    <p class="dek">{{ port.dek[lang] }}</p>
  </header>
  <div class="prose">
    <table class="port-facts-table">
      <tbody>
        {% if port.locode %}<tr><th scope="row">{{ t.ports.locode }}</th><td><code class="locode">{{ port.locode }}</code></td></tr>{% endif %}
        <tr><th scope="row">{{ t.ports.country }}</th><td>{{ port.country[lang] }}</td></tr>
        <tr><th scope="row">{{ t.ports.region }}</th><td>{{ regionName }}</td></tr>
        <tr><th scope="row">{{ t.ports.operator }}</th><td>{{ port.operator[lang] }}</td></tr>
        <tr><th scope="row">{{ t.ports.type }}</th><td>{{ port.type[lang] }}</td></tr>
      </tbody>
    </table>
    {% if port.note %}
    <h2>{{ t.ports.why }}</h2>
    <p>{{ port.note[lang] }}</p>
    {% endif %}
    <p class="port-stub">{{ t.ports.stub }}</p>
  </div>

  {% set ftSlug = port.slug %}{% include "freetime-port.njk" %}

  {%- set myLanes = rates.lanes | lanesFor(port.slug, 6) -%}
  {% if myLanes.length %}
  <section class="related">
    <h2>{{ t.misc.lanesHere }}</h2>
    <ul>
      {% for l in myLanes %}
      {%- set e = l | estimate(rates.indices) %}
      <li><a href="{{ ('/' + lang + '/rates/') | rel(page.url) }}">{{ l.from[lang] }} {{ "←" if lang == "ar" else "→" }} {{ l.to[lang] }} <span class="kind">{% if e %}{{ e.usd | num(lang) }} USD{% else %}{{ i18n[lang].rates.uncalibrated }}{% endif %}</span></a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  <p class="article-back"><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.ports.all }}</a></p>
</article>
