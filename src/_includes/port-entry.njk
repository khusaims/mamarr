{%- set t = i18n[lang] -%}
{%- set regionName = "" -%}
{%- for r in ports.regions -%}{%- if r.id == port.region -%}{%- set regionName = r[lang] -%}{%- endif -%}{%- endfor -%}
<article class="article wrap-narrow">
  <header class="article-head">
    <p class="article-section"><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.ports.title }}</a> · {{ regionName }}</p>
    <h1>{{ port.name[lang] }}</h1>
    <p class="dek">{{ port.dek[lang] }}</p>
  </header>
  <div class="prose">
    <table class="port-facts-table">
      <tbody>
        <tr><th scope="row">{{ t.ports.country }}</th><td>{{ port.country[lang] }}</td></tr>
        <tr><th scope="row">{{ t.ports.region }}</th><td>{{ regionName }}</td></tr>
        <tr><th scope="row">{{ t.ports.operator }}</th><td>{{ port.operator[lang] }}</td></tr>
        <tr><th scope="row">{{ t.ports.type }}</th><td>{{ port.type[lang] }}</td></tr>
      </tbody>
    </table>
    {% if port.note %}
    <h2>{{ t.ports.why }}</h2>
    <p>{{ port.note[lang] }}</p>
    {% endif %}
    <p class="port-stub">{{ t.ports.stub }}</p>
  </div>
  <p class="article-back"><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.ports.all }}</a></p>
</article>
