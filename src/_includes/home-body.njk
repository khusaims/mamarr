{%- set t = i18n[lang] -%}
{%- set articles = collections["articles_" + lang] -%}
{%- set portPages = collections["ports_" + lang] -%}
{%- set stops = t.corridor.stops -%}
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">{{ t.home.heroEyebrow }}</p>
        <h1>{{ t.home.heroTitle }}</h1>
        <p class="lead">{{ t.home.heroLead }}</p>
        <p class="hero-actions">
          <a class="hero-cta" href="#newsletter">{{ t.newsletter.title }}</a>
          <a class="hero-cta hero-cta-ghost" href="{{ ('/' + lang + '/freetime/') | rel(page.url) }}">{{ t.home.heroCta2 }}</a>
        </p>
      </div>

      <aside class="hero-panel" aria-label="{{ t.home.liveTitle }}">
        <p class="hero-panel-head">{{ t.home.liveTitle }}</p>
        <ul class="live-list">
          {% for ix in rates.indices %}
          {%- set dirClass = "up" if ix.change_pct > 0 else ("down" if ix.change_pct < 0 else "flat") %}
          <li>
            <span class="live-code">{{ ix.short[lang] }}</span>
            <span class="live-value">{{ ix.value | num(lang) }}</span>
            <span class="chg {{ dirClass }}">{{ ix.change_pct | pct(lang) }}</span>
          </li>
          {% endfor %}
        </ul>
        <p class="hero-panel-foot">{{ t.home.liveUpdated }} <time datetime="{{ rates.indices_updated }}">{{ rates.indices_updated | dateHuman(lang) }}</time></p>

        <div class="hero-ticker">
          <p class="hero-ticker-head">{{ t.advisories.homeTitle }}</p>
          <ul>
            {%- for c in advisories.changelog | head(2) %}
            <li>
              <span class="when" data-advisory-date="{{ c.date }}">{{ c.date | dateHuman(lang) }}</span><br>
              {{ c.short[lang] }}
            </li>
            {%- endfor %}
          </ul>
          <a class="more" href="{{ ('/' + lang + '/advisories/') | rel(page.url) }}">{{ t.advisories.homeAll }}</a>
        </div>
      </aside>
    </div>

    <figure class="corridor" aria-labelledby="corridor-caption">
      <div class="corridor-scroll"><svg viewBox="0 0 1000 190" role="img" aria-hidden="true">
        <!-- dashed sea lines for texture -->
        <path class="sea" d="M0 160 Q 250 150, 500 160 T 1000 160"/>
        <path class="sea" d="M0 178 Q 250 168, 500 178 T 1000 178"/>
        <!-- route: Shanghai (right) → Colombo → Salalah → Hormuz → Sohar → Jebel Ali (left) -->
        <path class="route" d="M 940 118 C 860 130, 780 150, 700 140 S 560 110, 480 108 S 380 90, 330 68 S 275 80, 250 92 S 150 112, 80 112"/>
        <!-- transit-day labels between stops -->
        <text class="days" x="820" y="162" text-anchor="middle">~12</text>
        <text class="days" x="590" y="150" text-anchor="middle">~5</text>
        <text class="days" x="405" y="118" text-anchor="middle">~2</text>
        <text class="days" x="290" y="112" text-anchor="middle">&lt;1</text>
        <text class="days" x="165" y="137" text-anchor="middle">~1</text>
        <!-- stops -->
        <circle class="stop" cx="940" cy="118" r="7"/><text class="stop-label" x="940" y="98" text-anchor="middle">{{ stops[0] }}</text>
        <circle class="stop" cx="700" cy="140" r="7"/><text class="stop-label" x="700" y="120" text-anchor="middle">{{ stops[1] }}</text>
        <circle class="stop" cx="480" cy="108" r="7"/><text class="stop-label" x="480" y="88" text-anchor="middle">{{ stops[2] }}</text>
        <circle class="stop" cx="330" cy="68" r="7"/><text class="stop-label" x="330" y="48" text-anchor="middle">{{ stops[3] }}</text>
        <circle class="stop" cx="250" cy="92" r="7"/><text class="stop-label" x="250" y="72" text-anchor="middle">{{ stops[4] }}</text>
        <circle class="stop" cx="80" cy="112" r="7"/><text class="stop-label" x="80" y="92" text-anchor="middle">{{ stops[5] }}</text>
      </svg></div>
      <figcaption class="corridor-caption" id="corridor-caption">{{ t.corridor.caption }}</figcaption>
    </figure>
  </div>
</section>

<section class="statbar">
  <div class="wrap">
    <ul>
      <li><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}"><strong>{{ ports.ports | length | num(lang) }}</strong> <span>{{ t.home.statPorts }}</span></a></li>
      <li><a href="{{ ('/' + lang + '/rates/') | rel(page.url) }}"><strong>{{ rates.lanes | length | num(lang) }}</strong> <span>{{ t.home.statLanes }}</span></a></li>
      <li><a href="{{ ('/' + lang + '/glossary/') | rel(page.url) }}"><strong>{{ glossary.terms | length | num(lang) }}</strong> <span>{{ t.home.statTerms }}</span></a></li>
      <li><a href="{{ ('/' + lang + '/events/') | rel(page.url) }}"><strong>{{ events.events | length | num(lang) }}</strong> <span>{{ t.home.statEvents }}</span></a></li>
    </ul>
  </div>
</section>

{%- set ftMin = freetime.entries | minVal("carrier.days") -%}
{%- set ftMax = freetime.entries | maxVal("carrier.days") -%}
<section class="section section-feature">
  <div class="wrap">
    <a class="feature-card" href="{{ ('/' + lang + '/freetime/') | rel(page.url) }}">
      <p class="feature-kicker">{{ t.home.ftBandKicker }}</p>
      <h2>{{ t.home.ftBandTitle | replace("{min}", ftMin | num(lang)) | replace("{max}", ftMax | num(lang)) }}</h2>
      <p class="feature-body">{{ t.home.ftBandBody }}</p>
      <p class="feature-cta">{{ t.home.ftBandCta }}</p>
    </a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ t.home.latest }}</h2>
      <a href="{{ ('/' + lang + '/articles/') | rel(page.url) }}">{{ t.home.allArticles }}</a>
    </div>
    <ul class="article-list">
      {% for a in articles | head(5) %}
      <li>
        <p class="meta meta-col"><time datetime="{{ a.date | dateISO }}">{{ a.date | dateHuman(lang) }}</time></p>
        <h3><a href="{{ a.url | rel(page.url) }}">{{ a.data.title }}</a></h3>
        {% if a.data.dek %}<p class="dek">{{ a.data.dek }}</p>{% endif %}
        <p class="meta"><span>{{ a.templateContent | readingTime(lang) }}</span></p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ t.home.ratesTitle }}</h2>
      <a href="{{ ('/' + lang + '/rates/') | rel(page.url) }}">{{ t.home.ratesAll }}</a>
    </div>
    <p class="section-lead">{{ t.home.ratesLead }}</p>
    {% include "rates-compact.njk" %}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>{{ t.home.toolsTitle }}</h2>
    <p class="section-lead">{{ t.home.toolsLead }}</p>
    <ul class="tool-grid">
      <li class="tool-card">
        <h3><a href="{{ ('/' + lang + '/calculator/') | rel(page.url) }}">{{ t.calc.title }}</a></h3>
        <p>{{ t.home.toolCalc }}</p>
      </li>
      <li class="tool-card">
        <h3><a href="{{ ('/' + lang + '/glossary/') | rel(page.url) }}">{{ t.glossary.title }}</a></h3>
        <p>{{ t.home.toolGlossary }}</p>
      </li>
      <li class="tool-card">
        <h3><a href="{{ ('/' + lang + '/events/') | rel(page.url) }}">{{ t.events.title }}</a></h3>
        <p id="home-next-event">{{ t.home.toolEvents }}</p>
      </li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ t.home.portsTitle }}</h2>
      <a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.ports.all }}</a>
    </div>
    <p class="section-lead">{{ t.home.portsLead }}</p>
    <ul class="port-list">
      {% for p in portPages %}
      <li>
        <h3><a href="{{ p.url | rel(page.url) }}">{{ p.data.title }}</a></h3>
        <p>{{ p.data.dek }}</p>
      </li>
      {% endfor %}
    </ul>

    <aside class="contribute-cta">
      <h3>{{ t.contribute.ctaTitle }}</h3>
      <p>{{ t.contribute.ctaText }}</p>
      <p><a class="btn-primary" href="{{ ('/' + lang + '/contribute/') | rel(page.url) }}">{{ t.contribute.ctaBtn }}</a></p>
    </aside>
  </div>
</section>

<script>
// Advisory dates are rendered at build time, then relabelled here, so a page
// built last week never claims an advisory is newer than it is.
(function () {
  var nodes = document.querySelectorAll("[data-advisory-date]");
  if (!nodes.length) return;
  try {
    var LANG = {{ lang | dump | safe }};
    var A = {{ i18n[lang].advisories | dump | safe }};
    var now = new Date(); now.setHours(0, 0, 0, 0);
    Array.prototype.forEach.call(nodes, function (el) {
      var d = new Date(el.getAttribute("data-advisory-date")); d.setHours(0, 0, 0, 0);
      var days = Math.round((now - d) / 86400000);
      if (days < 0) return;
      var num = days.toLocaleString(LANG === "ar" ? "ar-EG" : "en-US");
      el.textContent = days === 0 ? A.agoToday
        : days === 1 ? A.agoOne
        : days === 2 ? A.agoTwo
        : days <= 10 ? A.agoFew.replace("{n}", num)
        : A.ago.replace("{n}", num);
    });
  } catch (e) {}
})();
</script>

<script id="home-events" type="application/json">{{ events.events | dump | safe }}</script>
<script>
(function () {
  var el = document.getElementById("home-next-event");
  if (!el) return;
  try {
    var LANG = {{ lang | dump | safe }};
    var H = {{ i18n[lang].home | dump | safe }};
    var data = JSON.parse(document.getElementById("home-events").textContent);
    var now = new Date(); now.setHours(0, 0, 0, 0);
    var next = data.filter(function (e) { return !e.tbd && new Date(e.start) >= now; })
      .sort(function (a, b) { return new Date(a.start) - new Date(b.start); })[0];
    if (!next) return;
    var days = Math.round((new Date(next.start) - now) / 86400000);
    var num = days.toLocaleString(LANG === "ar" ? "ar-EG" : "en-US");
    var when = days === 0 ? H.whenToday
      : days === 1 ? H.whenTomorrow
      : days === 2 ? H.whenTwo
      : days <= 10 ? H.whenFew.replace("{n}", num)
      : H.whenMany.replace("{n}", num);
    el.textContent = H.nextEvent.replace("{name}", next.name[LANG]).replace("{when}", when);
  } catch (e) {}
})();
</script>
