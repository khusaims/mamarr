{%- set posts = collections["articles_" + lang] -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.name[lang] }}{% if lang == "en" %} — Gulf logistics{% endif %}</title>
    <link>{{ site.url }}/{{ lang }}/</link>
    <description>{{ site.tagline[lang] }}</description>
    <language>{{ lang }}</language>
    <atom:link href="{{ site.url }}/{{ lang }}/feed.xml" rel="self" type="application/rss+xml"/>
    {%- if posts.length %}
    <lastBuildDate>{{ posts[0].date.toUTCString() }}</lastBuildDate>
    {%- endif %}
    {%- for p in posts %}
    <item>
      <title>{{ p.data.title }}</title>
      <link>{{ site.url }}{{ p.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ p.url }}</guid>
      <pubDate>{{ p.date.toUTCString() }}</pubDate>
      <description>{{ p.data.dek or p.data.description }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
