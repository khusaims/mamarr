{%- set t = i18n[lang] -%}
{% if rates.indices_sample %}<p class="sample-banner">{{ t.rates.indicesSampleNotice }}</p>{% endif %}
<ul class="index-cards">
  {% for ix in rates.indices %}
  {%- set dirClass = "up" if ix.change_pct > 0 else ("down" if ix.change_pct < 0 else "flat") -%}
  <li class="index-card">
    <p class="index-short">{{ ix.short[lang] }}</p>
    <p class="index-name">{{ ix.name[lang] }}</p>
    <p class="index-value">{{ ix.value | num(lang) }} <span class="chg {{ dirClass }}">{{ ix.change_pct | pct(lang) }}</span></p>
    <p class="index-meta">{{ ix.unit[lang] }} · {{ ix.cadence[lang] }}</p>
    <span class="spark-{{ dirClass }}">{{ ix.series | sparkline(160, 34) | safe }}</span>
  </li>
  {% endfor %}
</ul>
<p class="rates-note">{{ t.rates.updated }}: <time datetime="{{ rates.indices_updated }}">{{ rates.indices_updated | dateHuman(lang) }}</time></p>
