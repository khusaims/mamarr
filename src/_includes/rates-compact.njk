{%- set t = i18n[lang] -%}
<table class="rates-table">
  <thead>
    <tr>
      <th scope="col">{{ t.rates.lane }}</th>
      <th scope="col" class="num-col">{{ t.rates.days }}</th>
      <th scope="col" class="num-col">{{ t.rates.rate }}</th>
      <th scope="col" class="num-col">{{ t.rates.change }}</th>
      <th scope="col" class="trend-col">{{ t.rates.trend }}</th>
    </tr>
  </thead>
  <tbody>
    {% for l in rates.lanes | head(6) %}
    {%- set e = l | estimate(rates.indices) -%}
    {%- set dirClass = "flat" if not e else ("up" if e.change_pct > 0 else ("down" if e.change_pct < 0 else "flat")) -%}
    <tr>
      <td class="lane">{{ l.from[lang] }} <span class="lane-arrow" aria-hidden="true">{{ "←" if lang == "ar" else "→" }}</span> {{ l.to[lang] }}</td>
      <td class="num">{{ l.days | num(lang) }}<small> {{ t.rates.daysUnit }}</small></td>
      <td class="num">{% if e %}{{ e.usd | num(lang) }}{% else %}<span class="uncal">{{ t.rates.uncalibrated }}</span>{% endif %}</td>
      <td>{% if e %}<span class="chg {{ dirClass }}">{{ e.change_pct | pct(lang) }}</span>{% else %}<span class="chg flat">—</span>{% endif %}</td>
      <td class="trend">{% if e %}<span class="spark-{{ dirClass }}">{{ e.series | sparkline | safe }}</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
