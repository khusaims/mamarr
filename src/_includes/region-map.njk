{%- set t = i18n[lang] -%}
{%- set map = ports.ports | regionMap(mapframe) -%}
{%- if map %}
{#- ============================================================
    قاعدة هذه الخريطة: **كل لون مكتوب في الوسم نفسه**، لا في CSS.
    متصفّح لا يطبّق fill من الأنماط على SVG يُسقط كل عنصر إلى قيمته
    الافتراضية — والافتراضي أسود — فتصير الخريطة لوحة سوداء. حدث ذلك
    فعلًا. الأنماط هنا للحركة والتفاعل فقط؛ اللوحة مقروءة بلا CSS إطلاقًا.
    ============================================================ -#}
{%- set C = {
  sea:    "#eaf2f3",
  land:   "#d9cdb6",
  coast:  "#9c9e92",
  grid:   "#c9c0ad",
  chain:  "#7fb0b5",
  pulse:  "#f2641b",
  dot:    "#155d66",
  home:   "#f2641b",
  ring:   "#ffffff",
  ink:    "#0e2f3f",
  halo:   "#f4f6f5",
  strait: "#155d66"
} -%}
{%- set labels = {
  "port-said":     { dx: 11,  dy: 4,   anchor: "start",  ar: "بورسعيد",   en: "Port Said" },
  "aqaba":         { dx: 11,  dy: 4,   anchor: "start",  ar: "العقبة",     en: "Aqaba" },
  "jeddah":        { dx: 11,  dy: 4,   anchor: "start",  ar: "جدة",        en: "Jeddah" },
  "dammam":        { dx: -11, dy: 4,   anchor: "end",    ar: "الدمام",     en: "Dammam" },
  "hamad-port":    { dx: 0,   dy: 22,  anchor: "middle", ar: "حمد",        en: "Hamad" },
  "jebel-ali":     { dx: 0,   dy: -15, anchor: "middle", ar: "جبل علي",    en: "Jebel Ali" },
  "sohar":         { dx: 10,  dy: -9,  anchor: "start",  ar: "صحار",       en: "Sohar" },
  "sultan-qaboos": { dx: 10,  dy: 15,  anchor: "start",  ar: "مسقط",       en: "Muscat" },
  "duqm":          { dx: -11, dy: 4,   anchor: "end",    ar: "الدقم",      en: "Duqm" },
  "salalah":       { dx: 11,  dy: 4,   anchor: "start",  ar: "صلالة",      en: "Salalah" }
} -%}
{%- set keyPorts = ["sohar", "sultan-qaboos", "duqm", "salalah", "jebel-ali"] -%}
<section class="section section-map">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ t.map.title }}</h2>
      <p>{{ t.map.lead }}</p>
    </div>

    <div class="map-layout">
      <figure class="regionmap" aria-labelledby="map-caption">
        <svg viewBox="0 0 {{ map.width }} {{ map.height }}" role="img"
             aria-label="{{ t.map.alt }}" preserveAspectRatio="xMidYMid meet"
             xmlns="http://www.w3.org/2000/svg">

          <rect x="0" y="0" width="{{ map.width }}" height="{{ map.height }}" fill="{{ C.sea }}"/>

          {%- if coastline.d %}
          <path d="{{ coastline.d }}" fill="{{ C.land }}" stroke="{{ C.coast }}"
                stroke-width="0.7" stroke-opacity="0.55"/>
          {%- endif %}

          <g stroke="{{ C.grid }}" stroke-width="0.5" opacity="0.45">
            {%- for i in range(1, 7) %}
            <line x1="{{ (map.width / 7 * i) | round(1) }}" y1="0"
                  x2="{{ (map.width / 7 * i) | round(1) }}" y2="{{ map.height }}"/>
            {%- endfor %}
            {%- for i in range(1, 5) %}
            <line x1="0" y1="{{ (map.height / 5 * i) | round(1) }}"
                  x2="{{ map.width }}" y2="{{ (map.height / 5 * i) | round(1) }}"/>
            {%- endfor %}
          </g>

          {#- السلاسل الساحلية: خطّ ثابت، وفوقه نبضة تجري -#}
          {%- for key, pts in map.chains %}{% if pts %}
          <polyline points="{{ pts }}" fill="none" stroke="{{ C.chain }}"
                    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          {%- set dur = {"redsea": 7, "gulfnorth": 6, "gulfsouth": 5, "oman": 8} -%}
          {%- set delay = {"redsea": 0, "gulfnorth": 1.1, "gulfsouth": 2.8, "oman": 2.3} -%}
          <polyline class="pulse" points="{{ pts }}" fill="none"
                    stroke="{{ C.pulse }}" stroke-width="2.6" stroke-linecap="round"
                    stroke-linejoin="round" stroke-dasharray="26 1400" stroke-opacity="0">
            <set attributeName="stroke-opacity" to="0.95" begin="{{ delay[key] }}s"/>
            <animate attributeName="stroke-dashoffset" from="1426" to="0"
                     dur="{{ dur[key] }}s" begin="{{ delay[key] }}s" repeatCount="indefinite"/>
          </polyline>
          {%- endif %}{% endfor %}

          {#- مضيق هرمز: الفجوة المقصودة، منقّطة لأنها ليست سلسلة موانئ -#}
          {%- set ja = map.byId["jebel-ali"] -%}
          {%- set kf = map.byId["khor-fakkan"] -%}
          {%- if ja and kf %}
          <path class="strait-arc" fill="none" stroke="{{ C.pulse }}" stroke-width="1.5"
                stroke-opacity="0.55" stroke-dasharray="4 5"
                d="M {{ ja.x }} {{ ja.y }} Q {{ (kf.x + 45) }} {{ (kf.y - 98) }} {{ kf.x }} {{ kf.y }}">
            <animate attributeName="stroke-dashoffset" from="0" to="-18"
                     dur="2.2s" repeatCount="indefinite"/>
          </path>
          <text class="strait-label" x="{{ (kf.x + 20) }}" y="{{ (kf.y - 58) }}"
                fill="{{ C.strait }}" font-size="12.5" font-weight="600"
                stroke="{{ C.halo }}" stroke-width="3.5" stroke-linejoin="round"
                paint-order="stroke">{{ t.map.strait }}</text>
          {%- endif %}

          {#- خطوط تُرسم عند اختيار ميناء: أقرب جيرانه برًّا -#}
          <g id="map-links" fill="none" stroke="{{ C.ink }}" stroke-width="1.5"
             stroke-opacity="0.55" stroke-dasharray="5 4" stroke-linecap="round"></g>

          <g class="ports">
            {%- for p in map.points %}
            {%- set lb = labels[p.slug] -%}
            {%- set near = distances | nearestTo(p.slug, 3) -%}
            {%- set ft = freetime.entries | freeTimeFor(p.slug) -%}
            <g class="port{% if p.home %} is-home{% endif %}{% if lb %} is-named{% endif %}{% if p.slug in keyPorts %} is-key{% endif %}"
               style="--i: {{ p.order }}"
               data-slug="{{ p.slug }}"
               data-x="{{ p.x }}" data-y="{{ p.y }}"
               data-name="{{ p.name[lang] }}"
               data-country="{{ p.country[lang] }}"
               data-locode="{{ p.locode or '' }}"
               data-href="{{ ('/' + lang + '/ports/' + p.slug + '/') | rel(page.url) }}"
               data-free="{% if ft and ft.carrier %}{{ ft.carrier.days | num(lang) }}{% endif %}"
               data-near="{% for n in near %}{%- set np = map.byId[n.other] -%}{% if np %}{{ np.name[lang] | shortName(lang) }}|{{ n.km | num(lang) }}|{{ np.x }}|{{ np.y }}{% if not loop.last %};{% endif %}{% endif %}{% endfor %}"
               tabindex="0" role="button"
               aria-label="{{ p.name[lang] }} — {{ p.country[lang] }}{% if p.locode %} ({{ p.locode }}){% endif %}">
              <title>{{ p.name[lang] }} — {{ p.country[lang] }}{% if p.locode %} · {{ p.locode }}{% endif %}</title>
              {%- if p.home %}
              <circle class="halo" cx="{{ p.x }}" cy="{{ p.y }}" r="5"
                      fill="none" stroke="{{ C.home }}" stroke-width="1.4" opacity="0">
                <animate attributeName="r" values="3;14" dur="3.4s"
                         begin="{{ (p.order * 0.055 + 0.7) | round(2) }}s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0.75;0" dur="3.4s"
                         begin="{{ (p.order * 0.055 + 0.7) | round(2) }}s" repeatCount="indefinite"/>
              </circle>
              {%- endif %}
              <circle class="sel-ring" cx="{{ p.x }}" cy="{{ p.y }}" r="11"
                      fill="none" stroke="{{ C.pulse }}" stroke-width="2" opacity="0"/>
              <circle class="hit" cx="{{ p.x }}" cy="{{ p.y }}" r="16" fill="transparent"/>
              {%- set t0 = (p.order * 0.055 / 2.4) -%}
              <circle class="dot" cx="{{ p.x }}" cy="{{ p.y }}"
                      r="{% if p.home %}5{% else %}3.6{% endif %}"
                      fill="{% if p.home %}{{ C.home }}{% else %}{{ C.dot }}{% endif %}"
                      stroke="{{ C.ring }}" stroke-width="1.4" opacity="1">
                <animate attributeName="opacity" values="0;0;1" dur="2.4s"
                         keyTimes="0;{{ t0 | round(3) }};{{ (t0 + 0.14) | round(3) }}" fill="freeze"/>
              </circle>
              {%- if lb %}
              <text class="label" x="{{ p.x + lb.dx }}" y="{{ p.y + lb.dy }}"
                    text-anchor="{{ lb.anchor }}"
                    fill="{% if p.home %}{{ C.strait }}{% else %}{{ C.ink }}{% endif %}"
                    font-size="13" font-weight="600"
                    stroke="{{ C.halo }}" stroke-width="3.5" stroke-linejoin="round"
                    paint-order="stroke">{{ lb[lang] }}</text>
              {%- else %}
              <text class="label label-hover" x="{{ p.x + 10 }}" y="{{ p.y - 10 }}"
                    text-anchor="start" fill="{{ C.ink }}" font-size="13" font-weight="500"
                    stroke="{{ C.halo }}" stroke-width="3.5" stroke-linejoin="round"
                    paint-order="stroke" opacity="0">{{ p.name[lang] | shortName(lang) }}</text>
              {%- endif %}
            </g>
            {%- endfor %}
          </g>
        </svg>
        <figcaption class="map-caption" id="map-caption">{{ t.map.caption }}</figcaption>
      </figure>

      {#- اللوحة: تُملأ عند اختيار ميناء. بلا جافاسكربت تبقى نصًّا إرشاديًا -#}
      <aside class="map-panel" id="map-panel" aria-live="polite">
        <p class="map-hint" id="map-hint">{{ t.map.hint }}</p>
        <div class="map-card" id="map-card" hidden>
          <p class="map-card-code" id="mc-code"></p>
          <h3 id="mc-name"></h3>
          <p class="map-card-country" id="mc-country"></p>
          <p class="map-card-free" id="mc-free" hidden></p>
          <p class="map-card-near-h" id="mc-near-h" hidden>{{ t.map.nearest }}</p>
          <ul class="map-card-near" id="mc-near"></ul>
          <a class="map-card-link" id="mc-link" href="#">{{ t.map.open }}</a>
        </div>
        <p class="map-allports"><a href="{{ ('/' + lang + '/ports/') | rel(page.url) }}">{{ t.map.cta }}</a></p>
      </aside>
    </div>
  </div>

  <script>
  (function () {
    var SVGNS = "http://www.w3.org/2000/svg";
    var root = document.querySelector(".section-map");
    if (!root) return;
    var ports = [].slice.call(root.querySelectorAll(".port"));
    var links = document.getElementById("map-links");
    var hint = document.getElementById("map-hint");
    var card = document.getElementById("map-card");
    if (!ports.length || !card || !links) return;

    // لا dataset ولا classList على عناصر SVG: محرّكات قديمة لا تعرّفهما،
    // فيتعطّل السكربت من أول سطر وتبدو الخريطة صورة ساكنة.
    function attr(el, name) { return el.getAttribute(name) || ""; }

    var el = {
      code: document.getElementById("mc-code"),
      name: document.getElementById("mc-name"),
      country: document.getElementById("mc-country"),
      free: document.getElementById("mc-free"),
      nearH: document.getElementById("mc-near-h"),
      near: document.getElementById("mc-near"),
      link: document.getElementById("mc-link")
    };
    var freeLabel = {{ t.map.freeDays | dump | safe }};
    var kmLabel = {{ t.distances.km | dump | safe }};
    var current = null;

    // من يطلب تقليل الحركة: تُنزع حركة SVG نفسها، فلا CSS يحكمها
    try {
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        var anims = [].slice.call(root.querySelectorAll("animate, set"));
        for (var i = 0; i < anims.length; i++) anims[i].parentNode.removeChild(anims[i]);
        var pulses = [].slice.call(root.querySelectorAll(".pulse"));
        for (var j = 0; j < pulses.length; j++) pulses[j].setAttribute("stroke-opacity", "0");
      }
    } catch (e) {}

    function label(g) { return g.querySelector(".label-hover"); }
    function ring(g) { return g.querySelector(".sel-ring"); }
    function dot(g) { return g.querySelector(".dot"); }

    function clearLinks() { while (links.firstChild) links.removeChild(links.firstChild); }

    function reset() {
      for (var i = 0; i < ports.length; i++) {
        var r = ring(ports[i]);
        if (r) r.setAttribute("opacity", "0");
        var d = dot(ports[i]);
        if (d) d.setAttribute("stroke-width", "1.4");
        var l = label(ports[i]);
        if (l) l.setAttribute("opacity", "0");
      }
      clearLinks();
    }

    function select(g) {
      if (current === g) { deselect(); return; }
      reset();
      var r = ring(g); if (r) r.setAttribute("opacity", "1");
      var d = dot(g); if (d) d.setAttribute("stroke-width", "2.6");
      var l = label(g); if (l) l.setAttribute("opacity", "1");
      current = g;

      el.code.textContent = attr(g, "data-locode");
      el.name.textContent = attr(g, "data-name");
      el.country.textContent = attr(g, "data-country");
      el.link.setAttribute("href", attr(g, "data-href"));

      var free = attr(g, "data-free");
      if (free) { el.free.textContent = freeLabel.replace("{n}", free); el.free.removeAttribute("hidden"); }
      else { el.free.setAttribute("hidden", "hidden"); }

      while (el.near.firstChild) el.near.removeChild(el.near.firstChild);
      var raw = attr(g, "data-near");
      var entries = raw ? raw.split(";") : [];
      if (entries.length) el.nearH.removeAttribute("hidden");
      else el.nearH.setAttribute("hidden", "hidden");

      var x0 = attr(g, "data-x"), y0 = attr(g, "data-y");
      for (var i = 0; i < entries.length; i++) {
        var bits = entries[i].split("|");
        if (bits.length < 4) continue;
        var li = document.createElement("li");
        var nm = document.createElement("span");
        nm.appendChild(document.createTextNode(bits[0]));
        var km = document.createElement("b");
        km.appendChild(document.createTextNode(bits[1] + " " + kmLabel));
        li.appendChild(nm); li.appendChild(km);
        el.near.appendChild(li);

        var line = document.createElementNS(SVGNS, "line");
        line.setAttribute("x1", x0); line.setAttribute("y1", y0);
        line.setAttribute("x2", bits[2]); line.setAttribute("y2", bits[3]);
        links.appendChild(line);
      }

      hint.setAttribute("hidden", "hidden");
      card.removeAttribute("hidden");
    }

    function deselect() {
      reset();
      current = null;
      card.setAttribute("hidden", "hidden");
      hint.removeAttribute("hidden");
    }

    for (var i = 0; i < ports.length; i++) {
      (function (g) {
        g.addEventListener("click", function () { select(g); });
        g.addEventListener("mouseover", function () {
          if (current === g) return;
          var l = label(g); if (l) l.setAttribute("opacity", "1");
          var d = dot(g); if (d) d.setAttribute("stroke-width", "2.6");
        });
        g.addEventListener("mouseout", function () {
          if (current === g) return;
          var l = label(g); if (l) l.setAttribute("opacity", "0");
          var d = dot(g); if (d) d.setAttribute("stroke-width", "1.4");
        });
        g.addEventListener("keydown", function (e) {
          var k = e.key || e.keyCode;
          if (k === "Enter" || k === " " || k === 13 || k === 32) { e.preventDefault(); select(g); }
          else if (k === "Escape" || k === 27) { deselect(); }
        });
      })(ports[i]);
    }
  })();
  </script>
</section>
{%- endif %}
