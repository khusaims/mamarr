{%- set t = i18n[lang] -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ t.freetime.title }}</h1>
    <p>{{ t.freetime.lead }}</p>
  </header>

  <section class="callout two-clocks">
    <h2>{{ t.freetime.twoClocks }}</h2>
    <p>{{ t.freetime.twoClocksBody }}</p>
    <p class="muted">{{ t.freetime.basis }}: {{ t.freetime.basisBody }}</p>
  </section>

  <div class="table-scroll">
    <table class="freetime-table">
      <caption class="sr-only">{{ t.freetime.title }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ t.ports.title }}</th>
          <th scope="col">{{ t.freetime.carrier }}</th>
          <th scope="col">{{ t.freetime.afterFree }}</th>
          <th scope="col">{{ t.freetime.terminal }}</th>
          <th scope="col">{{ t.freetime.source }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for e in freetime.entries -%}
        {%- set p = ports.ports | portBySlug(e.port) -%}
        {%- if p %}
        <tr>
          <th scope="row">
            <a href="{{ ('/' + lang + '/ports/' + p.slug + '/') | rel(page.url) }}">{{ p.name[lang] }}</a>
            <span class="kind">{{ p.country[lang] }}</span>
          </th>
          <td class="num-cell"><strong>{{ e.carrier.days | num(lang) }}</strong> <span class="kind">{{ t.freetime.days }}</span></td>
          <td>{{ e.carrier.firstTier[lang] }}</td>
          <td class="num-cell">
            {%- if e.terminal %}<strong>{{ e.terminal.freeDays | num(lang) }}</strong> <span class="kind">{{ t.freetime.days }}</span>
            {%- else %}<span class="kind">{{ t.freetime.unknown }}</span>{% endif %}
          </td>
          <td><a href="{{ e.carrier.source }}" rel="nofollow noopener">{{ e.carrier.sourceName }}</a></td>
        </tr>
        {%- endif -%}
        {%- endfor %}
      </tbody>
    </table>
  </div>

  <p class="muted caveat">{{ t.freetime.caveat }}</p>

  {%- for e in freetime.entries -%}
  {%- set p = ports.ports | portBySlug(e.port) -%}
  {%- if p %}
  <section class="freetime-detail" id="ft-{{ p.slug }}">
    <h2><a href="{{ ('/' + lang + '/ports/' + p.slug + '/') | rel(page.url) }}">{{ p.name[lang] }}</a></h2>
    <dl class="ft-dl">
      <dt>{{ t.freetime.scope }}</dt>
      <dd>{{ e.carrier.scope[lang] }} · {{ e.carrier.name }}</dd>
      <dt>{{ t.freetime.carrier }}</dt>
      <dd>{{ e.carrier.types[lang] }}. {{ t.freetime.afterFree }}: {{ e.carrier.firstTier[lang] }}.</dd>
      <dt>{{ t.freetime.terminal }}</dt>
      <dd>
        {%- if e.terminal %}{{ e.terminal.note[lang] }}
        <a href="{{ e.terminal.source }}" rel="nofollow noopener">{{ e.terminal.sourceName }}</a>
        {%- else %}{{ t.freetime.unknownBody }}{% endif %}
      </dd>
      <dt>{{ t.freetime.verified }}</dt>
      <dd><time datetime="{{ e.verified }}">{{ e.verified }}</time></dd>
    </dl>
  </section>
  {%- endif -%}
  {%- endfor %}

  <section class="callout ask-box">
    <h2>{{ t.freetime.ask }}</h2>
    <p>{{ t.freetime.askBody }}</p>
    <p><a class="btn-primary" href="{{ ('/' + lang + '/contribute/') | rel(page.url) }}">{{ t.freetime.askCta }}</a></p>
  </section>
</div>
