---
layout: base.njk
---
{%- set t = i18n[lang] -%}
<article class="article wrap-narrow">
  <header class="article-head">
    {% if section %}<p class="article-section"><a href="{{ ('/' + lang + '/' + section + '/') | rel(page.url) }}">{{ t.nav.analysis if section == 'articles' else t.ports.title }}</a></p>{% endif %}
    <h1>{{ title }}</h1>
    {% if dek %}<p class="dek">{{ dek }}</p>{% endif %}
    <p class="article-meta">
      {% if author %}<span>{{ author }}</span>{% endif %}
      <time datetime="{{ date | dateISO }}">{{ date | dateHuman(lang) }}</time>
      <span>{{ content | readingTime(lang) }}</span>
      <button type="button" class="linkish" data-copy data-copied="{{ t.article.copied }}">{{ t.article.share }}</button>
    </p>
  </header>
  <div class="prose">
    {% if section == "articles" %}{{ content | linkTerms(lang, page.url) | safe }}{% else %}{{ content | safe }}{% endif %}
  </div>

  {%- set relTerms = content | mentionedTerms(lang, 8) -%}
  {%- set relPorts = content | mentionedPorts(lang, 6) -%}
  {% if relTerms.length or relPorts.length %}
  <section class="related">
    <h2>{{ t.misc.related }}</h2>
    <ul>
      {% for x in relTerms %}<li><a href="{{ ('/' + lang + '/glossary/' + x.slug + '/') | rel(page.url) }}">{{ x.text }} <span class="kind">{{ t.misc.kindTerm }}</span></a></li>{% endfor %}
      {% for x in relPorts %}{% if x.slug != page.fileSlug %}<li><a href="{{ ('/' + lang + '/ports/' + x.slug + '/') | rel(page.url) }}">{{ x.text }} <span class="kind">{{ t.misc.kindPort }}</span></a></li>{% endif %}{% endfor %}
    </ul>
  </section>
  {% endif %}
  {% if section == 'articles' %}
  <aside class="article-note"><p>{{ t.article.disclaimer }}</p></aside>
  {% include "author-box.njk" %}
  {% endif %}
  <p class="article-back"><a href="{{ ('/' + lang + '/' + (section or 'articles') + '/') | rel(page.url) }}">{{ t.ports.all if section == 'ports' else t.article.back }}</a></p>
</article>
