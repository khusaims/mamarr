{%- set t = i18n[lang] -%}
<div class="wrap">
  <header class="page-head">
    <h1>{{ t.rates.title }}</h1>
    <p>{{ t.rates.lead }}</p>
  </header>
  <section class="rates-section">
    <h2>{{ t.rates.indicesTitle }}</h2>
    <p class="section-lead">{{ t.rates.indicesLead }}</p>
    {% include "indices.njk" %}
  </section>

  <section class="rates-section">
    <h2>{{ t.nav.rates }}</h2>
    {% include "rates-table.njk" %}
  </section>
  <section class="wrap-narrow" style="padding-inline:0; margin-inline-start:0; margin-top:2.5rem">
    <h2>{{ t.rates.method }}</h2>
    <p>{{ t.rates.methodText }}</p>
  </section>
</div>
